<UserControl x:Class="FF12Rando.SetupPaths"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FF12Rando"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignWidth="921.305" d:DesignHeight="211.404" >
    <StackPanel>
    <Grid>
        <Grid.Resources >
            <Style TargetType="Border" >
                <Setter Property="Padding" Value="1,5,1,5" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130px" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250px" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Column="1" Grid.Row="0">
            <Label x:Name="PathsCountLabel" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Content="{Binding PathsCountText, Mode=OneWay}" FontWeight="Bold"/>
        </Border>
        <Border Grid.Column="2" Grid.Row="0">
                <Button x:Name="refreshButton" Click="refreshButton_Click" 
                        Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh"/>
                        <Label Margin="0 -6">Re-check Installed Mods</Label>
                    </StackPanel>
                </Button>
        </Border>
        <Border Grid.Column="0" Grid.Row="1">
            <Label HorizontalAlignment="Right">FF12 Steam Path</Label>
        </Border>
        <Border Grid.Column="1" Grid.Row="1">
            <TextBox x:Name="steamPath12Text" IsReadOnly="True" Text="{Binding FF12Path, Mode=OneWay}" Foreground="Gray"/>
        </Border>
        <Border Grid.Column="2" Grid.Row="1">
            <Button x:Name="steamPath12Button" Click="steamPath12Button_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Folder"/>
                    <Label Margin="0 -6">Select FF12 Folder</Label>
                </StackPanel>
            </Button>
        </Border>
    </Grid>

    <!-- Bordered so the header reads as a panel you can open rather than a stray line of text.
         Starts collapsed when nothing needs attention; see SetupPaths.AllModsReady. -->
    <Border Margin="0,8,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="#5A5A5A">
        <Expander x:Name="ModsExpander" IsExpanded="True" Padding="4,0">
            <Expander.Header>
                <TextBlock Text="Mod Setup (click to expand/collapse)" FontWeight="Bold"/>
            </Expander.Header>
    <!-- One row per entry in FF12ModViews, so a new mod needs no markup here. -->
    <ItemsControl ItemsSource="{Binding ModViews}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="1,5,1,5" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130px" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250px" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <Label HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RowLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                        </Label>
                    </Border>
                    <Border Grid.Column="1">
                        <Label VerticalAlignment="Center" Content="{Binding Text}" Foreground="{Binding Color}"/>
                    </Border>
                    <Border Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="modDownloadButton_Click" Margin="0 0 5 0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Download"/>
                                    <Label Margin="0 -6">Download</Label>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Click="modInstallButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrayArrowDown"/>
                                    <Label Margin="0 -6">Install</Label>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
        </Expander>
    </Border>
</StackPanel>
</UserControl>
